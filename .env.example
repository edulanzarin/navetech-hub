# Copie para .env (é o arquivo que o Docker Compose e o Next leem):
#   cp .env.example .env
# .env é gitignored — nenhuma credencial vai para o repositório.

# Nome do projeto Docker Compose — governa prefixos de recurso sem depender do
# nome da pasta. Containers/volume/rede já têm nome explícito (navetech-hub-*).
COMPOSE_PROJECT_NAME=navetech-hub

# Banco do Questor (produção, somente leitura)
QUESTOR_DB_HOST=
QUESTOR_DB_PORT=5432
QUESTOR_DB_NAME=
QUESTOR_DB_USER=
QUESTOR_DB_PASSWORD=

# Porta em que o app atende na rede: http://<ip-do-computador>:4022
# Mude se 4022 já estiver em uso na máquina de produção.
APP_PORT=4022

# Senha do banco próprio do app. É aplicada na PRIMEIRA subida, quando o volume
# é criado — trocar depois exige `docker compose down -v` (apaga os dados) ou
# um ALTER USER no banco.
APP_DB_PASSWORD=

# Conexão de DESENVOLVIMENTO com o banco próprio (publicado em 127.0.0.1:5022 —
# espelho da porta 4022 do app — pelo docker-compose.dev.yml). Use a mesma senha
# de APP_DB_PASSWORD. Dentro do compose o serviço `app` sobrescreve isto para app-db:5432.
APP_DB_URL=postgres://navetechhub:SENHA@localhost:5022/navetechhub

# Usuário inicial do app.
# A senha só é usada para criar o usuário na primeira subida; no banco ela vai
# gravada como hash, nunca em texto puro. Se contiver # ou espaço, use aspas
# simples: ADMIN_PASSWORD='minha#senha'
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Módulo RH ─────────────────────────────────────────────────────────────────
# URL pública do app, usada para montar o link do formulário de experiência no
# e-mail (sem barra final). Em produção, o endereço acessível pelos gestores.
APP_URL=http://localhost:4022

# Envio de e-mail (SMTP) do formulário de experiência. Sem SMTP_HOST, o app só
# registra o e-mail no log do servidor (não envia) — bom para desenvolvimento.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Segredo do job diário de experiência (/api/rh/cron/experiencia). O cron do host
# bate a rota com este segredo no header x-cron-secret. Sem ele, a rota fica
# desabilitada. Exemplo de cron (todo dia às 8h):
#   0 8 * * * curl -fsS -H "x-cron-secret: SEU_SEGREDO" http://localhost:4022/api/rh/cron/experiencia
RH_CRON_SECRET=

# Claude / Anthropic (Análise de Balancete por IA)
# Peça a chave ao responsável e cole aqui (formato sk-ant-...).
ANTHROPIC_API_KEY=
# Modelo da análise (opcional). Padrão: claude-sonnet-5.
# Use claude-opus-4-8 para o modo "premium" (mais caro, laudo mais rico).
ANALISE_MODELO=
